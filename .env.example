# Detecto backend configuration
# Copy this file to .env and adjust as needed. The tracked .env already
# contains safe local defaults.

# Model / inference
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONF=0.25
YOLO_IMGSZ=640
CONTRAST_ENHANCE=false

# Uploads
MAX_UPLOAD_MB=50

# Storage
DETECTION_STORAGE_PATH=storage/detections.json
MAX_HISTORY_RECORDS=10000

# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
